# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://medhkarm:medhkarm@localhost:5442/medhkarm
REDIS_URL=redis://localhost:6379/0
# Sign-in: signs session tokens. Required outside development (a long random string).
# AUTH_SECRET=
# Encrypts founders' own API keys (default: AUTH_SECRET). Keep it fixed once set.
# SECRETS_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Models (LiteLLM names). Ollama Cloud key from https://ollama.com/settings/keys
DEFAULT_MODEL=ollama_chat/gpt-oss:20b
OLLAMA_API_BASE=https://ollama.com
OLLAMA_API_KEY=

# Sandbox
# Python + Node + pytest; built from backend/sandbox-image/ on first use
SANDBOX_IMAGE=medhkarm-sandbox:4
# Where sandboxes run: docker (this machine) or daytona (hosted; from the beta). Daytona needs a key.
SANDBOX_PROVIDER=docker
# DAYTONA_API_KEY=
# DAYTONA_TARGET=us
# DAYTONA_SNAPSHOT=

# Developer engine: builtin (ToolLoopEngine + plain Docker) or openhands (OpenHands agent server)
DEVELOPER_ENGINE=builtin
OPENHANDS_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.50.1-python
OPENHANDS_MAX_ITERATIONS=50
OPENHANDS_SUPPRESS_BANNER=1

# Built-in engine: maximum tool-calling steps per task
BUILTIN_MAX_STEPS=25
BUILTIN_APPLY_PATCH=false

# Team template (backend/app/features/teams/templates/<id>.toml)
TEAM_TEMPLATE=software

# Daily standup: the 24 hours up to STANDUP_HOUR in STANDUP_TIMEZONE
STANDUP_TIMEZONE=Asia/Kolkata
STANDUP_HOUR=9
STANDUP_STALL_MINUTES=120
STANDUP_SCHEDULE=true

# Background jobs (Postgres job queue)
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=60
JOB_RETRY_SECONDS=30
BUILD_MAX_ATTEMPTS=3

# GitHub: fine-grained token with Contents + Pull requests (read/write) on the repos the team
# works on. Empty: public repos still clone, but released work isn't pushed.
GITHUB_TOKEN=

# Code graph experiment (Graphify in the sandbox image): richer codebase map + explain_symbol
CODE_GRAPH=false

# DevOps (Neel): preview and production deploys on Vercel. Token: vercel.com → Account Settings → Tokens
VERCEL_TOKEN=
VERCEL_TEAM=

# Nightly eval suite: all tasks, pass rate, cost and time per task (results in backend/evals/results/)
EVAL_NIGHTLY=false
EVAL_NIGHTLY_HOUR=2
EVAL_NIGHTLY_ENGINES=["builtin"]
EVAL_NIGHTLY_PARALLEL=2

# Updates to founders (docs/technical/features/notifications.md). Email: Resend, or SMTP.
# RESEND_API_KEY=
# EMAIL_FROM=MedhKarm <onboarding@resend.dev>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# WhatsApp: Meta's WhatsApp Cloud API, with an approved template "medhkarm_update"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=medhkarm_update
# WHATSAPP_TEMPLATE_LANGUAGE=en
# Links in updates point here
# APP_URL=http://localhost:3000
